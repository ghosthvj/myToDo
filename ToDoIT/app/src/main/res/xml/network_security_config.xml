<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Development: allow HTTP cleartext to any host.
        Production: remove this base-config and add only the specific domain
        with HTTPS once the reverse proxy is set up.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
